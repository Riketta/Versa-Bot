# Compose deployment secrets. Copy to `.env` (gitignored) and fill in the
# real values:
#
#   cp .env.example .env
#
# docker-compose.yaml passes this file into the container (env_file): every
# VERSABOT__* line here configures the bot directly, and LLM provider keys
# are resolved by the env var names given in [llm.providers.*] `api_key_env`.
# The same file also feeds ${...} substitution in the compose file
# (e.g. POSTGRES_PASSWORD).

# Discord bot token (required).
VERSABOT__DISCORD__TOKEN=your-token

# Optional: Sentry-protocol endpoint (Sentry SaaS or self-hosted GlitchTip).
# Absent or empty means stdout logging only.
# VERSABOT__SENTRY__DSN=http://your-key@glitchtip.example:9000/1
# VERSABOT__SENTRY__ENVIRONMENT=production

# Optional: LLM provider API keys, referenced by name from
# [llm.providers.*] api_key_env in versabot.toml.
# VERSABOT_LLM_ZAI_KEY=your-key

# Optional: PostgreSQL password for the commented `db` service in
# docker-compose.yaml.
# POSTGRES_PASSWORD=change-me
